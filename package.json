{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-stack.mjs",
    "dev:web": "next dev",
    "build": "next build",
    "start": "next start",
    "db:up": "docker compose up -d db",
    "db:up:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-postgres.ps1",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "ai:dev": "py -3.10 -m ai_service.app",
    "ai:models": "py -3.10 -m ai_service.check_layers",
    "ai:test": "py -3.10 -m unittest ai_service.tests.test_service",
    "test": "vitest run",
    "test:integration": "node --env-file=.env --test tests/api.integration.test.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/pdf-parse": "^1.1.5",
    "@types/three": "^0.186.0",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^14.1.0",
    "jose": "^6.2.12",
    "jspdf": "^4.2.1",
    "next": "^16.4.0",
    "pdf-parse": "^2.4.5",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-dropzone": "^20.1.3",
    "recharts": "^3.10.1",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "three": "^0.186.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8.5.23",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  }
}
